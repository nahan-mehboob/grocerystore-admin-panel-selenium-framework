<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Include Exclude Suite">
	<listeners>
		<listener class-name="com.groceryadmin.automation.listeners.ExtentReportManager" />
	</listeners>
	<test name="Selective Tests">
		<parameter name="Browser" value="chrome"></parameter>
		<parameter name="Headless" value="true"></parameter>
		<classes>
			<class name="com.groceryadmin.automation.tests.LoginTestCases">
				<methods>
					<include name="loginFailureWithInvalidCredentials"></include>
					<include name="validateLoginWithEmptyCredentials"></include>
				</methods>

				<!-- <class name="com.groceryadmin.automation.tests.ManageProductTestCases">
				<methods>
					<exclude name="validateUploadedFileIsPreviewDisplayed"></exclude>
				</methods>-->
			</class>
		</classes>
	</test>
</suite>