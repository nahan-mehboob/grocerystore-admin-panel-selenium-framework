<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="GroceryStore Test Suite">
	<listeners>
		<listener class-name="com.groceryadmin.automation.listeners.ExtentReportManager" />
	</listeners>
	<test name="Admin Panel Tests">
		<parameter name="Browser" value="chrome"></parameter>
		<parameter name="Headless" value="true"></parameter>
		<classes>
			<class name="com.groceryadmin.automation.tests.LoginTestCases" />
			<class name="com.groceryadmin.automation.tests.HomeTestCases" />
			<class name="com.groceryadmin.automation.tests.ManageDeliveryBoyTestCases" />
			<class name="com.groceryadmin.automation.tests.MobileSliderTestCases" />
			<class name="com.groceryadmin.automation.tests.PushNotificationsTestCases" />
			<class name="com.groceryadmin.automation.tests.ManageExpenseTestCases" />
			<class name="com.groceryadmin.automation.tests.SettingsPageTestCases" />
			<class name="com.groceryadmin.automation.tests.ManageOrdersTestCases" />
			<class name="com.groceryadmin.automation.tests.ManageProductTestCases" />
			<class name="com.groceryadmin.automation.tests.ManageLocationTestCases" />
			<class name="com.groceryadmin.automation.tests.AdminUsersTestCases" />
		</classes>
	</test>
</suite>